# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
*.tmp

# Local virtual environments and editor state
.venv/
venv/
env/
.idea/
.vscode/
.DS_Store
*.swp
*~
exports/

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Runtime model checkpoints
*.pt
*.pth
SmartGen/IoT_model/
SmartGen/check_model/

# GCAD cache artifacts (recomputed from TSS output)
SmartGen/IoT_data/*/*/gcad_hints.json
SmartGen/artifacts/

# Per-run prompts, responses and resumable manifests
SmartGen/runs/

# Runtime data is archived through experiment_archive; tracked upstream GPT-4o
# reference files remain tracked even though these rules cover their directories.
SmartGen/anomaly_runs/
SmartGen/filter_data/
SmartGen/IoT_data/*/*/trn_day_*

# Per-prompt generation responses
SmartGen/IoT_data/*/*/*_generation_day_*.pkl

# Self-contained experiment archives: keep metadata in Git, heavy artifacts locally.
experiment_archive/**/artifacts/
experiment_archive/.*-/
